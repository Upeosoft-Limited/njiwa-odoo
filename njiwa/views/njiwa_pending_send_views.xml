<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="njiwa_pending_send_view_tree" model="ir.ui.view">
        <field name="name">njiwa.pending.send.tree</field>
        <field name="model">njiwa.pending.send</field>
        <field name="arch" type="xml">
            <tree string="Njiwa messages" create="false" edit="false" delete="false">
                <field name="create_date" string="Queued"/>
                <field name="record_name"/>
                <field name="event"/>
                <field name="to_number"/>
                <field name="state"/>
                <field name="message_id" optional="hide"/>
                <field name="failure_reason"/>
            </tree>
        </field>
    </record>

    <record id="njiwa_pending_send_view_form" model="ir.ui.view">
        <field name="name">njiwa.pending.send.form</field>
        <field name="model">njiwa.pending.send</field>
        <field name="arch" type="xml">
            <form string="Njiwa message" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="record_name"/>
                            <field name="event"/>
                            <field name="to_number"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="create_date" string="Queued"/>
                            <field name="attempts"/>
                            <field name="message_id"/>
                            <field name="idempotency_key"/>
                        </group>
                    </group>
                    <group string="What happened">
                        <field name="failure_reason" nolabel="1" colspan="2"/>
                    </group>
                    <div class="text-muted">
                        The message itself is not kept here. Njiwa stores every message it has
                        been given, with its status and its failure reason, and a second copy
                        would be a second thing to keep in step.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="njiwa_pending_send_view_search" model="ir.ui.view">
        <field name="name">njiwa.pending.send.search</field>
        <field name="model">njiwa.pending.send</field>
        <field name="arch" type="xml">
            <search string="Njiwa messages">
                <field name="record_name"/>
                <field name="to_number"/>
                <filter name="waiting" string="Waiting" domain="[('state', '=', 'queued')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <group expand="0" string="Group by">
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_event" string="Event" context="{'group_by': 'event'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="njiwa_pending_send_action" model="ir.actions.act_window">
        <field name="name">Njiwa messages</field>
        <field name="res_model">njiwa.pending.send</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_waiting': 1, 'search_default_failed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has been queued yet.</p>
            <p>
                Every WhatsApp message this database has arranged is listed here: the ones
                waiting to go out, the ones that went, and the ones Njiwa refused and why.
                Each one also writes a note on the order, the invoice or the delivery it
                belongs to.
            </p>
        </field>
    </record>

    <menuitem id="njiwa_pending_send_menu"
              name="Njiwa messages"
              parent="sale.menu_sale_config"
              action="njiwa_pending_send_action"
              groups="base.group_system"
              sequence="92"/>
</odoo>
